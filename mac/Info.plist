<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>circal</string>
	<key>CFBundleDisplayName</key>
	<string>circal</string>
	<key>CFBundleIdentifier</key>
	<string>app.circal.mac</string>
	<key>CFBundleExecutable</key>
	<string>circal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>circal</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- One fixed loopback port serves the build, because localStorage is keyed
	     by origin and an origin includes its port. Two copies of the app would
	     race for that socket and the loser would have no calendar. -->
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<!-- The same fact, from App Transport Security's side: this app's only
	     plaintext HTTP is to 127.0.0.1, inside its own process's bundle. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
