# dependencies
node_modules/

# pnpm is the only package manager here (`packageManager` pins it), so an npm
# or yarn lockfile is always the residue of a mistyped command. Ignored rather
# than tolerated: committed, one would let somebody `npm ci` a dependency tree
# nothing in this repo has ever resolved.
package-lock.json
yarn.lock

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# cloudflare
.wrangler/

# jetbrains setting folder
.idea/

