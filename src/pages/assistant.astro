---
import Base from "@/layouts/Base.astro";
import { ActionPill, IconButton, TextField } from "@/components/react/ui/primitives";
import Dropdown from "@/components/assistant/Dropdown.astro";
import { Copy } from "lucide-react";

import { clients, clientConfiguration } from "@/components/assistant/clients";

const initialClient = clients.find((client) => client.value === "omp")!;
const initialConfig = clientConfiguration(initialClient, "cloud", "");
const examples = [
  "What’s on Thursday?",
  "Find me an hour free tomorrow afternoon.",
  "Book dentist next Tuesday at 2.",
  "Move my standup to 10.",
];
---

<Base
  title="Connect your AI agent · circal"
  description="Choose your MCP client and connect it to circal’s mirror file or encrypted cloud copy with copyable setup instructions."
  scroll
>
  <main class="mx-auto w-full max-w-[60rem] px-5 pt-10 pb-20 sm:px-8 sm:pt-14">
    <nav class="flex items-center justify-between" aria-label="Page navigation">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-[15px] font-medium tracking-[-0.02em] text-ink-2 transition-colors hover:text-ink"
        aria-label="Open circal"
      >
        <svg viewBox="0 0 24 24" class="size-[15px]" aria-hidden="true"
          ><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle></svg
        >
        circal
      </a>
      <a
        href="https://github.com/VSHT3/circal/tree/main/mcp"
        class="text-[13px] text-ink-2 underline decoration-hairline underline-offset-4 hover:text-ink"
        >Server documentation ↗</a
      >
    </nav>

    <header class="mt-14 mb-10 sm:mt-18">
      <p class="label text-ink-2">MCP setup</p>
      <h1
        class="mt-4 text-[34px] leading-[1.1] font-medium tracking-[-0.035em] text-balance text-ink sm:text-[46px]"
      >
        Connect your AI agent.
      </h1>
      <p class="mt-4 max-w-[38rem] text-[16px] leading-[1.7] text-ink-2">
        Let your agent check your agenda and make changes to your calendar. Choose a client and the
        copy of your calendar it should use.
      </p>
    </header>

    <div id="assistant-setup">
      <section
        class="rounded-xl border border-hairline bg-surface px-5 sm:px-7"
        aria-labelledby="connection-heading"
      >
        <h2 id="connection-heading" class="sr-only">Connection options</h2>
        <div class="setup-row">
          <p class="text-[14px] text-ink">Client</p>
          <Dropdown
            id="client-picker"
            label="MCP client"
            value="omp"
            options={clients}
            searchLabel="Search MCP clients"
          />
        </div>
        <div class="setup-row border-t border-hairline">
          <div>
            <p class="text-[14px] text-ink">Calendar connection</p>
            <p class="mt-1 text-[13px] text-ink-2">Use the copy connected in circal Settings.</p>
          </div>
          <div
            id="connection-picker"
            role="radiogroup"
            aria-label="Calendar connection"
            data-value="cloud"
            class="flex flex-wrap gap-3"
          >
            <IconButton
              label="Cloud copy"
              role="radio"
              aria-checked={true}
              tabIndex={0}
              data-connection="cloud"
              className="connection-radio"
            >
              <span class="radio-circle" aria-hidden="true"><span data-radio-dot></span></span>Cloud
              copy
            </IconButton>
            <IconButton
              label="Mirror file"
              role="radio"
              aria-checked={false}
              tabIndex={-1}
              data-connection="file"
              className="connection-radio"
            >
              <span class="radio-circle" aria-hidden="true"
                ><span data-radio-dot hidden></span></span
              >Mirror file
            </IconButton>
          </div>
        </div>
        <div data-file-only hidden class="setup-row border-t border-hairline">
          <div>
            <p class="text-[14px] text-ink">Mirror file path</p><p
              class="mt-1 text-[13px] text-ink-2"
            >
              Paste the full path reported by --find.
            </p>
          </div>
          <div data-field="path">
            <TextField
              defaultValue=""
              label="Mirror file path"
              placeholder="/absolute/path/to/calendar.json"
              autoComplete="off"
              className="w-full font-mono"
            /><p id="path-note" class="mt-2 text-[12px] leading-relaxed text-ink-2">
              The browser cannot read your file’s full path. This field stays on this page.
            </p>
          </div>
        </div>
      </section>
      <aside
        id="client-limitation"
        hidden
        class="mt-5 rounded-lg border border-hairline bg-surface p-4 text-[14px] leading-[1.8] text-ink-2"
        aria-live="polite"
      >
      </aside>

      <p class="mt-5 text-[13px] leading-[1.7] text-ink-2">
        Requires <a
          href="https://nodejs.org/en/download"
          class="text-ink underline decoration-hairline underline-offset-4"
          >Node.js 22.22.3 or later</a
        > on the computer running your agent. The server runs locally over stdio, including when you use
        the cloud copy.
      </p>
      <noscript
        ><p class="mt-4 text-[14px] text-ink-2">
          Enable JavaScript to switch clients and generate configuration. The steps below connect
          omp to an existing cloud copy.
        </p></noscript
      >

      <section class="mt-12" aria-labelledby="steps-heading">
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline pb-5"
        >
          <h2 id="steps-heading" class="text-[20px] font-medium tracking-[-0.025em] text-ink">
            Follow these steps
          </h2>
          <ActionPill
            label="Copy setup prompt"
            icon="Copy prompt"
            data-copy="setup"
            className="border border-hairline px-3 text-[13px]"
          />
        </div>
        <p id="copy-status" role="status" class="mt-2 min-h-5 text-[12px] text-ink-2"></p>
        <div id="manual-copy" hidden class="code-box mt-4">
          <p class="code-heading text-[13px] text-ink-2">Copy this text manually</p>
          <pre id="manual-copy-text" tabindex="-1" class="whitespace-pre-wrap"></pre>
        </div>

        <ol class="flex flex-col">
          <li data-requires-local class="step-row">
            <div class="step-heading">
              <span class="step-number" aria-hidden="true">1</span><div>
                <h3 class="text-[15px] font-medium text-ink">Prepare your calendar</h3><p
                  class="mt-1 text-[13px] leading-relaxed text-ink-2"
                >
                  Connect a live copy before adding the server.
                </p>
              </div>
            </div>
            <div class="min-w-0">
              <div data-cloud-only>
                <p class="setup-copy">
                  In <a href="/" class="setup-link">circal</a>, open Settings → Cloud. Sign in and
                  unlock your cloud copy with your passphrase. If this is your first time, let
                  circal upload the calendar before continuing.
                </p>
                <p class="setup-copy mt-3">
                  On the computer running your agent, run the command below. Enter your email, the
                  emailed code and the same passphrase in the terminal. Keep them out of agent chat.
                </p>
              </div>
              <div data-file-only hidden>
                <p class="setup-copy">
                  In <a href="/" class="setup-link">circal</a>, open Settings → Mirror and connect a
                  .json file. The macOS app creates a default mirror on first launch unless you have
                  disconnected it.
                </p>
                <p class="setup-copy mt-3">
                  Run the command below. It searches common locations and reports valid mirror files
                  without changing them. Paste your calendar’s full path into the field above. If it
                  finds nothing, use the path of the file you selected in Settings.
                </p>
              </div>
              <div class="code-box mt-4">
                <div class="code-heading">
                  <span class="text-[12px] text-ink-2">Terminal</span><IconButton
                    label="Copy preparation command"
                    data-copy="prepare"><Copy size={14} strokeWidth={1.75} /></IconButton
                  >
                </div><pre><code id="prepare-code">npx -y circal-mcp@latest login</code></pre>
              </div>
              <p data-cloud-only class="mt-3 text-[13px] leading-relaxed text-ink-2">
                Login stores a session and a derived key on this computer. It never stores or sends
                your passphrase.
              </p>
              <p data-file-only hidden class="mt-3 text-[13px] leading-relaxed text-ink-2">
                The agent can use the file while circal is closed. Keep Mirror connected when you
                open circal so changes can sync back.
              </p>
            </div>
          </li>
          <li class="step-row border-t border-hairline">
            <div class="step-heading">
              <span data-requires-local class="step-number" aria-hidden="true">2</span><div>
                <h3 id="configure-heading" class="text-[15px] font-medium text-ink">
                  Configure your client
                </h3><p id="client-caption" class="mt-1 text-[13px] leading-relaxed text-ink-2">
                  For omp
                </p>
              </div>
            </div>
            <div class="min-w-0">
              <p id="client-instruction" class="setup-copy">{initialClient.instruction}</p>
              <p id="config-warning" hidden class="mt-3 text-[13px] text-ink-2">
                Enter your mirror file path above before copying this configuration.
              </p>
              <div id="client-config-box" class="code-box mt-4">
                <div class="code-heading">
                  <span
                    id="config-destination"
                    class="min-w-0 truncate font-mono text-[12px] text-ink-2"
                    >{initialClient.destination}</span
                  ><IconButton label="Copy client configuration" data-copy="config"
                    ><Copy size={14} strokeWidth={1.75} /></IconButton
                  >
                </div><pre><code id="config-code">{initialConfig}</code></pre>
              </div>
              <p id="client-alternative" class="mt-3 text-[13px] leading-[1.7] text-ink-2">
                {initialClient.alternative}
              </p>
              <a
                id="client-docs"
                href={initialClient.docs}
                class="setup-link mt-3 inline-block text-[13px]">View omp docs ↗</a
              >
            </div>
          </li>
          <li data-requires-local class="step-row border-t border-hairline">
            <div class="step-heading">
              <span class="step-number" aria-hidden="true">3</span><div>
                <h3 class="text-[15px] font-medium text-ink">Check the connection</h3><p
                  class="mt-1 text-[13px] leading-relaxed text-ink-2"
                >
                  Confirm the right calendar before making changes.
                </p>
              </div>
            </div>
            <div class="min-w-0">
              <p id="client-restart" class="setup-copy">{initialClient.restart}</p>
              <p class="setup-copy mt-3">
                Ask your agent to call sync_status. Check the connection type, timezone and record
                counts against your calendar.
              </p>
              <div class="code-box mt-4">
                <div class="code-heading">
                  <span class="text-[12px] text-ink-2">Ask your agent</span><IconButton
                    label="Copy connection check prompt"
                    data-copy="check"><Copy size={14} strokeWidth={1.75} /></IconButton
                  >
                </div><pre
                  class="whitespace-pre-wrap"><code id="check-code">Call circal’s sync_status and tell me the transport, timezone and record counts. Do not change anything.</code></pre>
              </div>
            </div>
          </li>
          <li data-requires-local class="step-row border-t border-hairline">
            <div class="step-heading">
              <span class="step-number" aria-hidden="true">4</span><div>
                <h3 class="text-[15px] font-medium text-ink">
                  Install the circal skill <span class="font-normal text-ink-2">(optional)</span>
                </h3>
                <p class="mt-1 text-[13px] leading-relaxed text-ink-2">
                  Give your agent instructions for using the calendar tools.
                </p>
              </div>
            </div>
            <div class="min-w-0">
              <p class="setup-copy">
                The circal skill explains how to check the connection, work with events and tasks,
                and handle recurring events without changing the wrong occurrences. It adds
                instructions, not calendar access; the MCP connection above is still required.
              </p>
              <div class="code-box mt-4">
                <div class="code-heading">
                  <span class="text-[12px] text-ink-2">Terminal</span><IconButton
                    label="Copy skill installation command"
                    data-copy="skills"><Copy size={14} strokeWidth={1.75} /></IconButton
                  >
                </div><pre><code id="skills-code">npx skills add VSHT3/circal --skill circal</code></pre>
              </div>
              <p class="mt-3 text-[13px] leading-[1.7] text-ink-2">
                Choose your agent in the installer and the scope you want. If it is not listed,
                follow your client’s skill installation instructions and copy the complete <code
                  class="font-mono text-[12px]">skills/circal</code
                > folder, including its references. Some clients do not support skills.
              </p>
              <a
                href="https://github.com/VSHT3/circal/tree/main/skills/circal"
                class="setup-link mt-3 inline-block text-[13px]">Read the circal skill ↗</a
              >
            </div>
          </li>
        </ol>
      </section>
    </div>

    <section class="mt-5 border-t border-hairline pt-8" aria-labelledby="try-heading">
      <h2 id="try-heading" class="text-[20px] font-medium tracking-[-0.025em] text-ink">
        Try it with your calendar
      </h2>
      <p class="mt-2 text-[14px] leading-relaxed text-ink-2">
        Start with a question. Review the date and calendar before approving a change.
      </p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          examples.map((example) => (
            <li class="rounded-lg bg-surface px-4 py-3 text-[14px] leading-relaxed text-ink-2">
              “{example}”
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10 border-t border-hairline pt-8" aria-labelledby="access-heading">
      <h2 id="access-heading" class="text-[20px] font-medium tracking-[-0.025em] text-ink">
        What you’re giving access to
      </h2>
      <p class="mt-3 max-w-[44rem] text-[14px] leading-[1.8] text-ink-2">
        The server can read and change your own events and tasks. Cloud storage holds encrypted
        data, but your agent receives readable results from the server. Your AI provider’s data
        policy applies to those results.
      </p>
      <ul class="mt-4 flex flex-col gap-2 text-[13px] leading-[1.8] text-ink-2">
        <li>
          Subscribed calendars stay read-only. Their feed events are not in the connected copy, so
          availability checks cannot account for them. Editing or deleting a repeating event
          requires an explicit scope: one occurrence, future occurrences or the whole series.
        </li>
        <li>
          Writes are refused when the server’s timezone differs from the calendar’s recorded
          timezone, unless you explicitly override that guard.
        </li>
        <li>
          Cloud setup requires an existing account and uploaded copy. The MCP server does not create
          either.
        </li>
        <li>
          There is no server-wide read-only setting. Use your client’s tool permissions to restrict
          changes.
        </li>
      </ul>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="text-[14px] font-medium text-ink">Disconnect a file</h3><p
            class="mt-2 text-[13px] leading-[1.8] text-ink-2"
          >
            Remove circal from your client’s MCP configuration and stop its server. Disconnecting
            Mirror in circal stops app sync; it does not revoke access to the file. Protect or
            remove that file separately.
          </p>
        </div>
        <div>
          <h3 class="text-[14px] font-medium text-ink">Disconnect the cloud copy</h3><p
            class="mt-2 text-[13px] leading-[1.8] text-ink-2"
          >
            Run <code class="font-mono text-[12px] text-ink">npx -y circal-mcp@latest logout</code> to
            remove this machine’s saved session and key. Remove circal from your client’s configuration
            too. Anyone who can read the credentials file can access your calendar.
          </p>
        </div>
      </div>
    </section>
    <footer class="mt-12 flex flex-wrap gap-5 border-t border-hairline pt-6 text-[13px] text-ink-2">
      <a href="/" class="setup-link">Open circal</a><a href="/manifesto/" class="setup-link"
        >Read the manifesto</a
      >
    </footer>
  </main>
</Base>

<style>
  [hidden] {
    display: none !important;
  }
  .setup-row {
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .setup-row[hidden] {
    display: none;
  }
  .step-row {
    display: grid;
    gap: 1.25rem;
    padding-block: 1.75rem;
  }
  .step-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .step-number {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--hairline);
    border-radius: 0.5rem;
    font: 12px var(--font-mono);
    color: var(--ink-2);
  }
  .setup-copy {
    font-size: 14px;
    line-height: 1.8;
    color: var(--ink-2);
  }
  .setup-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-underline-offset: 4px;
  }
  .setup-link:hover {
    text-decoration-color: var(--ink-2);
  }
  .code-box {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 0.625rem;
    background: var(--surface);
  }
  .code-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }
  pre {
    overflow-x: auto;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    color: var(--ink);
  }
  :global(.connection-radio) {
    display: flex;
    width: auto;
    height: 40px;
    gap: 9px;
    padding: 0 12px;
    font-size: 14px;
    color: var(--ink-2);
  }
  :global(.connection-radio[aria-checked="true"]) {
    color: var(--ink);
  }
  .radio-circle {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border: 1px solid var(--ink-3);
    border-radius: 50%;
  }
  .radio-circle span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
  }
  @media (min-width: 640px) {
    .setup-row {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
    }
    .step-row {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>

<script>
  import { clients, clientConfiguration } from "@/components/assistant/clients";

  const root = document.querySelector<HTMLElement>("#assistant-setup");
  if (root) {
    const client = root.querySelector<HTMLElement>("#client-picker")!;
    const connection = root.querySelector<HTMLElement>("#connection-picker")!;
    const path = root.querySelector<HTMLInputElement>('[data-field="path"] input')!;
    const status = root.querySelector<HTMLElement>("#copy-status")!;
    const manual = root.querySelector<HTMLElement>("#manual-copy")!;
    const text = (id: string, value: string) => {
      root.querySelector<HTMLElement>(`#${id}`)!.textContent = value;
    };
    const requestedConnection = new URLSearchParams(location.search).get("connection");
    if (requestedConnection === "file" || requestedConnection === "cloud")
      connection.dataset.value = requestedConnection;

    function update() {
      const selected = clients.find((item) => item.value === client.dataset.value)!;
      const file = connection.dataset.value === "file";
      connection.querySelectorAll<HTMLButtonElement>("[data-connection]").forEach((radio) => {
        const selected = radio.dataset.connection === connection.dataset.value;
        radio.setAttribute("aria-checked", String(selected));
        radio.tabIndex = selected ? 0 : -1;
        radio.querySelector<HTMLElement>("[data-radio-dot]")!.hidden = !selected;
      });
      const missingPath = selected.supported && file && !path.value.trim();
      const config = clientConfiguration(selected, file ? "file" : "cloud", path.value.trim());
      root!.querySelectorAll<HTMLElement>("[data-file-only]").forEach((element) => {
        element.hidden = !file || !selected.supported;
      });
      root!.querySelectorAll<HTMLElement>("[data-cloud-only]").forEach((element) => {
        element.hidden = file;
      });
      root!.querySelectorAll<HTMLElement>("[data-requires-local]").forEach((element) => {
        element.hidden = !selected.supported;
      });
      const limitation = root!.querySelector<HTMLElement>("#client-limitation")!;
      limitation.hidden = !selected.limitation;
      limitation.textContent = selected.limitation ?? "";
      root!.querySelector<HTMLElement>("#client-config-box")!.hidden = !selected.supported;
      root!.querySelector<HTMLElement>("#config-warning")!.hidden = !missingPath;
      root!.querySelector<HTMLButtonElement>('[data-copy="config"]')!.disabled =
        missingPath || !selected.supported;
      root!.querySelector<HTMLButtonElement>('[data-copy="setup"]')!.disabled = missingPath;
      text("steps-heading", selected.supported ? "Follow these steps" : "Client compatibility");
      text(
        "configure-heading",
        selected.supported ? "Configure your client" : "Use a local MCP client",
      );
      text(
        "prepare-code",
        file ? "npx -y circal-mcp@latest --find" : "npx -y circal-mcp@latest login",
      );
      text("client-caption", `For ${selected.label}`);
      text("client-instruction", selected.instruction);
      text("client-alternative", selected.alternative);
      text("client-restart", selected.restart);
      text("config-destination", selected.destination);
      text("config-code", config);
      const docs = root!.querySelector<HTMLAnchorElement>("#client-docs")!;
      docs.href = selected.docs;
      docs.textContent = `View ${selected.label} docs ↗`;
      manual.hidden = true;
      status.textContent = "";
    }

    client.addEventListener("change", update);
    const radios = Array.from(connection.querySelectorAll<HTMLButtonElement>("[data-connection]"));
    radios.forEach((radio, index) => {
      const choose = () => {
        connection.dataset.value = radio.dataset.connection;
        update();
      };
      radio.addEventListener("click", choose);
      radio.addEventListener("keydown", (event) => {
        if (
          ["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End"].includes(event.key)
        ) {
          event.preventDefault();
          const next =
            event.key === "Home"
              ? 0
              : event.key === "End"
                ? radios.length - 1
                : (index + 1) % radios.length;
          radios[next].click();
          radios[next].focus();
        }
      });
    });
    path.addEventListener("input", update);
    update();

    root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const kind = button.dataset.copy;
        let content: string;
        if (kind === "setup") {
          const selected = clients.find((item) => item.value === client.dataset.value)!;
          const requirements = selected.supported
            ? "Requires Node.js 22.22.3 or later on the computer running your agent. circal uses a local stdio server, including for its cloud copy."
            : (selected.limitation ?? selected.instruction);
          // Copy the displayed steps so client-specific notes and optional installation cannot drift.
          content = `Connect ${selected.label} to circal (${connection.dataset.value === "cloud" ? "encrypted cloud copy" : "mirror file"}).\n${requirements}\n\n${root!.querySelector<HTMLElement>("ol")!.innerText}\n\nYour agent receives readable calendar results. Review its tool permissions before allowing changes.\nClient docs: ${selected.docs}`;
          if (selected.supported)
            content += "\nSkill source: https://github.com/VSHT3/circal/tree/main/skills/circal";
        } else {
          const ids: Record<string, string> = {
            prepare: "prepare-code",
            config: "config-code",
            check: "check-code",
            skills: "skills-code",
          };
          content = root!.querySelector(`#${ids[kind!]}`)!.textContent ?? "";
        }
        try {
          await navigator.clipboard.writeText(content);
          manual.hidden = true;
          status.textContent = kind === "setup" ? "Setup prompt copied." : "Copied.";
        } catch {
          text("manual-copy-text", content);
          manual.hidden = false;
          status.textContent = "Clipboard unavailable. Copy the selected text below.";
          const copyText = root!.querySelector<HTMLElement>("#manual-copy-text")!;
          copyText.focus();
          const range = document.createRange();
          range.selectNodeContents(copyText);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
        }
      });
    });
  }
</script>
