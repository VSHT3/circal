---
import "@/styles/global.css";

/**
 * The two faces the first paint actually uses, preloaded.
 *
 * Fontsource already ships `font-display: swap`, so the flash is a fallback
 * rather than nothing — but the font is only *discovered* once the stylesheet
 * has been fetched and parsed, which is one round trip after the HTML. These
 * two links move that discovery into the first response. Latin only, and only
 * the normal weight: the variable file carries every weight the app draws, and
 * the other subsets are what `unicode-range` exists to keep off the wire.
 *
 * Imported rather than written as a path, because Vite content-hashes both
 * files and a hardcoded URL would preload a 404 — which is worse than no
 * preload, since it downloads and then discards.
 */
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /**
   * Let the document scroll. The base layer locks `body` because the app is
   * exactly one viewport and nothing in it scrolls but lists; a page of prose
   * is the one thing here that is taller than the window.
   */
  scroll?: boolean;
}

const { title, description, scroll = false } = Astro.props;

/**
 * Absolute, because every crawler that reads these requires it — a relative
 * `og:image` is simply dropped. `Astro.site` is the production origin, so this
 * points at circal.app even from a dev preview; the alternative is a card that
 * works nowhere.
 */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

/**
 * A string rather than inline script content: inside an Astro expression the
 * tag's body is parsed as JSX, where a bare `{}` is a broken expression.
 */
const registerServiceWorker = `window.addEventListener("load",()=>{navigator.serviceWorker.register("/sw.js").catch(()=>{})})`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="circal" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="circal" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="circal — a day is a circle" />
    {
      /* `summary_large_image` is the only card that shows a 1.91:1 image at
         full width; `summary` would crop the wordmark to a square. */
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {
      /* Only in production: a worker caching `astro dev`'s output would serve
         a stale bundle over the one that just hot-reloaded. */
    }
    {import.meta.env.PROD && <script is:inline set:html={registerServiceWorker} />}
  </head>
  <body class={scroll ? "overflow-y-auto" : undefined}>
    <slot />
  </body>
</html>
