{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "circal",
  "compatibility_date": "2026-08-05",

  // Assets-only Worker: no `main`. Circal is a client-side app — events live in
  // the browser's localStorage — so the build is pure static output and there
  // is no server work to put a Worker runtime in front of.
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "single-page-application",
  },
}
