{
  "name": "circal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "dev:worker": "astro build && wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mcp": "esbuild mcp/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=mcp/dist/circal-mcp.mjs --external:@modelcontextprotocol/server --external:zod --external:@supabase/supabase-js --alias:@=./src",
    "mcp": "\"$npm_execpath\" run build:mcp && node mcp/dist/circal-mcp.mjs",
    "build:mac": "astro build && bash mac/build.sh",
    "mac": "\"$npm_execpath\" run build:mac && open mac/build/circal.app",
    "verify": "\"$npm_execpath\" run format:check && \"$npm_execpath\" run lint && \"$npm_execpath\" run check && \"$npm_execpath\" run test && \"$npm_execpath\" run build:mcp && \"$npm_execpath\" run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.9",
    "clsx": "^2.1.1",
    "linkify-it": "^6.1.0",
    "lucide-react": "^1.33.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
